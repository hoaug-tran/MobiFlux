                    <DataGrid.Columns>
                      <DataGridTextColumn Header="{DynamicResource Ui.Col.NewIp}" Binding="{Binding CurrentIp}" Width="180" />
                      <DataGridTextColumn Header="{DynamicResource Ui.Col.PrevIp}" Binding="{Binding PreviousIp}" Width="180" />
                      <DataGridTextColumn Header="{DynamicResource Ui.Col.Time}" Binding="{Binding ChangedAt}" Width="140" />
