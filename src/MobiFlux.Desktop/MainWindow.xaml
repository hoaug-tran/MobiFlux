                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Ui.Title.Routing}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
