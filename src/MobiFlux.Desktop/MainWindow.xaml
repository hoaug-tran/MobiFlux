                          <DataTemplate>
                            <Border Style="{StaticResource Badge.Success}">
                              <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Status}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                              </StackPanel>
                            </Border>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>

                    <Border Visibility="{Binding HasNoRotations, Converter={StaticResource VisibleWhenTrue}}" Padding="32" MinHeight="300">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="42" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,14" HorizontalAlignment="Center" />
                        <TextBlock Text="Chưa có lịch sử xoay IP di động nào" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" />
                        <TextBlock Text="Nhấn nút [Kích Hoạt Xoay IP Ngay] để gửi lệnh reset kết nối cellular qua ADB và nhận dải IP WAN mới." Foreground="{DynamicResource Brush.Muted}" FontSize="13" Margin="0,6,0,18" HorizontalAlignment="Center" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding RotateNowCommand}" HorizontalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Kích Hoạt Xoay IP Ngay" />
