                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding NetstatConnections.Count, StringFormat='Tổng: {0} sockets'}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
