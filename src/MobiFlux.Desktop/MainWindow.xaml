                      <TextBlock Text="Chưa có phiên kết nối proxy nào được ghi nhận" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" />
                      <TextBlock Text="Khi client kết nối qua cổng proxy, các session TCP/TLS và lưu lượng trao đổi sẽ hiển thị tại đây theo thời gian thực." Foreground="{DynamicResource Brush.Muted}" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer Visibility="{Binding IsRoutingActive, Converter={StaticResource VisibleWhenTrue}}" VerticalScrollBarVisibility="Auto">
