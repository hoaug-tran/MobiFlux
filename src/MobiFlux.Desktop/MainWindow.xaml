                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshNetworkingCommand}">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="Làm Mới Mạng" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>

              <Border Style="{StaticResource MetricCard}" Margin="0,0,0,20">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
