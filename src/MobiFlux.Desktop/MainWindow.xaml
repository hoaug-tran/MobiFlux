                    <DataGridTextColumn Header="Chiến Lược (Strategy)" Binding="{Binding Strategy}" Width="200" />
                    <DataGridTextColumn Header="Sticky TTL (s)" Binding="{Binding StickyTtlSeconds}" Width="140" />
