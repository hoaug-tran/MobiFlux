                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                      <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" FontSize="16" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PingResultSummary}" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Border>

              <Border Style="{StaticResource MetricCard}" Margin="0,0,0,20">
                <StackPanel>
