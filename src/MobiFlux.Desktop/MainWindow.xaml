                        </StackPanel>
                        <TextBlock Text="Giữ nguyên cùng 1 IP di động cho 1 Client IP trong suốt TTL." FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>

                    <Button Style="{StaticResource StrategyBtn.Least}"
                            Command="{Binding SelectStrategyCommand}"
                            CommandParameter="LeastConnections"
                            Height="Auto"
                            Padding="16,14"
                            HorizontalContentAlignment="Left">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <ui:SymbolIcon Symbol="Pulse24" FontSize="18" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Accent}" />
                          <TextBlock Text="Least Connections" FontWeight="Bold" FontSize="15" />
                        </StackPanel>
                        <TextBlock Text="Điều phối request tới node di động có ít kết nối mở nhất." FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>
                  </UniformGrid>

                  <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="8" Padding="18" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Thời Gian Duy Trì Phiên Cố Định (Sticky Session TTL)" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.Text}" />
                          <TextBlock Text="Sau khoảng thời gian này không có hoạt động, IP sẽ tự động xoay phiên mới." FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding RoutingStickyTtl}" FontFamily="Consolas" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.Accent}" />
