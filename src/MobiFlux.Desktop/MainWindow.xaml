                              <TextBlock Text="ACTIVE" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer Visibility="{Binding IsRotationActive, Converter={StaticResource VisibleWhenTrue}}" VerticalScrollBarVisibility="Auto">
