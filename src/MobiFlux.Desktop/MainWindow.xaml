                               Text="{Binding PingTimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                               Margin="0,0,10,0"
                               VerticalContentAlignment="Center" />
                      <Button Grid.Column="2"
                              Style="{StaticResource Button.Primary}"
