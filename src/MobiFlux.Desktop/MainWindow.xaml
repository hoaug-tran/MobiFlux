                  </Grid>
                </Border>

                <Border Style="{StaticResource MetricCard}" Margin="0,0,0,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="ADB Host Controller &amp; Loopback Port Forwarding" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Brush.Text}" />
                      <TextBlock Text="Tiến trình nhận diện thiết bị và chuyển tiếp cổng loopback 18080 - 18082." FontSize="13" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Badge.Success}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="READY" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>

                <Border Style="{StaticResource MetricCard}" Margin="0,0,0,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Cellular Fail-Closed Security Policy" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Brush.Text}" />
                      <TextBlock Text="Cấm tuyệt đối fallback ra mạng Ethernet hoặc Wi-Fi máy tính khi mất kết nối di động." FontSize="13" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Badge.Accent}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="ENFORCED" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="DNS Leak Prevention &amp; Remote Resolver" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Brush.Text}" />
                      <TextBlock Text="Tất cả truy vấn tên miền DNS được giải quyết trực tiếp trên node di động Android qua mạng cellular." FontSize="13" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Badge.Success}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="SECURE" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <Grid Visibility="{Binding IsLogsActive, Converter={StaticResource VisibleWhenTrue}}" Margin="32,24,32,24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
              <TextBlock Text="{DynamicResource Ui.Title.Logs}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
              <TextBlock Text="{DynamicResource Ui.Subtitle.Logs}" Foreground="{DynamicResource Brush.Muted}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
              <ListBox ItemsSource="{Binding SystemLogs}"
                       Background="Transparent"
                       BorderThickness="0"
                       FontFamily="Consolas, Cascadia Code">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="{DynamicResource Brush.Muted}" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" FontSize="12" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{DynamicResource Brush.Text}" FontSize="12" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>

          <ScrollViewer Visibility="{Binding IsSettingsActive, Converter={StaticResource VisibleWhenTrue}}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,24">
              <TextBlock Text="{DynamicResource Ui.Title.Settings}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
              <TextBlock Text="{DynamicResource Ui.Subtitle.Settings}" Foreground="{DynamicResource Brush.Muted}" FontSize="13" Margin="0,4,0,20" />

              <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                  <TextBlock Text="Địa chỉ Service API Control Plane" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.Text}" />
                  <TextBox Text="http://127.0.0.1:5080/"
                           FontFamily="Consolas"
                           Margin="0,8,0,18"
                           IsReadOnly="True" />

                  <TextBlock Text="Địa chỉ Loopback Interface" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.Text}" />
                  <TextBox Text="127.0.0.1"
                           FontFamily="Consolas"
                           Margin="0,8,0,18"
                           IsReadOnly="True" />

                  <TextBlock Text="Dải Cổng Proxy Mặc Định" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.Text}" />
                  <TextBox Text="1080 - 1099"
                           FontFamily="Consolas"
                           Margin="0,8,0,18"
                           IsReadOnly="True" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid Visibility="{Binding IsCreateProxyDialogOpen, Converter={StaticResource VisibleWhenTrue}}"
                Background="#80000000">
            <Border Width="480"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Modal}"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
              <StackPanel>
                <TextBlock Text="Tạo Proxy Endpoint Mới" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,16" />

                <TextBlock Text="Tên Proxy" FontSize="13" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                <TextBox Text="{Binding NewProxyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Cổng Port Listener" FontSize="13" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                <TextBox Text="{Binding NewProxyPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Giao Thức (Protocol)" FontSize="13" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                <TextBox Text="{Binding NewProxyProtocol, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0"
                          Style="{StaticResource Button.Secondary}"
                          Command="{Binding CloseCreateProxyDialogCommand}"
                          Content="Hủy Bỏ"
                          Margin="0,0,6,0" />
                  <Button Grid.Column="1"
                          Style="{StaticResource Button.Primary}"
                          Command="{Binding ConfirmCreateProxyCommand}"
                          Content="Tạo Proxy"
                          Margin="6,0,0,0" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Visibility="{Binding IsRegisterDeviceDialogOpen, Converter={StaticResource VisibleWhenTrue}}"
                Background="#80000000">
            <Border Width="480"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Modal}"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
              <StackPanel>
                <TextBlock Text="Đăng Ký Thiết Bị Android Mới" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,16" />

                <TextBlock Text="Tên / Model Thiết Bị" FontSize="13" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                <TextBox Text="{Binding NewDeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="ADB Serial Number" FontSize="13" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                <TextBox Text="{Binding NewDeviceSerial, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0"
                          Style="{StaticResource Button.Secondary}"
                          Command="{Binding CloseRegisterDeviceDialogCommand}"
                          Content="Hủy Bỏ"
                          Margin="0,0,6,0" />
                  <Button Grid.Column="1"
                          Style="{StaticResource Button.Primary}"
                          Command="{Binding ConfirmRegisterDeviceCommand}"
                          Content="Đăng Ký Node"
                          Margin="6,0,0,0" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Visibility="{Binding IsCreatePoolDialogOpen, Converter={StaticResource VisibleWhenTrue}}"
                Background="#80000000">
            <Border Width="480"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Modal}"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
              <StackPanel>
                <TextBlock Text="Tạo Proxy Pool Mới" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,16" />

                <TextBlock Text="Tên Pool" FontSize="13" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                <TextBox Text="{Binding NewPoolName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Chiến Lược (RoundRobin, LeastConnections, Random)" FontSize="13" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                <TextBox Text="{Binding NewPoolStrategy, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Sticky Session TTL (giây)" FontSize="13" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
                <TextBox Text="{Binding NewPoolStickyTtl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0"
                          Style="{StaticResource Button.Secondary}"
                          Command="{Binding CloseCreatePoolDialogCommand}"
                          Content="Hủy Bỏ"
                          Margin="0,0,6,0" />
                  <Button Grid.Column="1"
                          Style="{StaticResource Button.Primary}"
                          Command="{Binding ConfirmCreatePoolCommand}"
                          Content="Tạo Pool"
                          Margin="6,0,0,0" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="32,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Info24" FontSize="15" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Muted}" FontSize="12" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="MobiFlux v1.0.0 (x64)" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" FontFamily="Consolas" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
