                        <StackPanel Orientation="Horizontal">
                          <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Accent}" />
                          <TextBlock Text="Round-Robin Balance" FontWeight="Bold" FontSize="15" />
                        </StackPanel>
                        <TextBlock Text="Xoay vòng tải tuần tự qua từng thiết bị di động có sẵn." FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>

                    <Button Style="{StaticResource StrategyBtn.Sticky}"
                            Command="{Binding SelectStrategyCommand}"
                            CommandParameter="StickySession"
                            Height="Auto"
                            Padding="16,14"
                            Margin="0,0,10,0"
                            HorizontalContentAlignment="Left">
