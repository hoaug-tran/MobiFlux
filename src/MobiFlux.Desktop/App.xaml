<Application x:Class="MobiFlux.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:contracts="clr-namespace:MobiFlux.Shared.Contracts;assembly=MobiFlux.Shared"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ControlsDictionary />
        <ui:ThemesDictionary Theme="Light" />
        <ResourceDictionary Source="Themes/DesignTokens.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
        <ResourceDictionary Source="Themes/Strings.vi.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate DataType="{x:Type contracts:DeviceDto}">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
      </DataTemplate>
      <DataTemplate DataType="{x:Type contracts:ProxyEndpointDto}">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
      </DataTemplate>
      <DataTemplate DataType="{x:Type contracts:ProxyPoolDto}">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
