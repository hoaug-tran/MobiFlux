{
  "urls": "http://127.0.0.1:5080",
  "Storage": { "DatabasePath": "data/mobiflux.db" },
  "Adb": { "ExecutablePath": "adb", "AgentForwardPortStart": 19000 },
  "Proxy": { "DefaultMaxConnections": 64, "DefaultDnsMode": "RemoteOnly", "ConnectTimeoutSeconds": 30, "IdleTimeoutSeconds": 300 },
  "Routing": { "MaxStickyEntries": 100000 },
  "Sessions": { "BufferCapacity": 10000, "PersistenceBatchSize": 250, "PersistenceIntervalSeconds": 5, "PersistenceRetryCount": 3, "PersistenceRetryDelaySeconds": 2 },
  "Api": { "MaximumPageSize": 500 },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.AspNetCore": "Warning" } },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/mobiflux-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14, "shared": true } }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
